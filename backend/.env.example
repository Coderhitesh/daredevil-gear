# =====================================================================
# DareDevil Gears — environment configuration
# Backend configuration. Copy to backend/.env and fill in real values. Never commit .env files.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =====================================================================

# ---- API -------------------------------------------------------------
NODE_ENV=development
PORT=4000
STOREFRONT_URL=http://localhost:3000
# Instant storefront refresh after admin changes (banners, offers, products…). Use the same long random
# value in frontend/.env.local. STOREFRONT_INTERNAL_URL = how this server reaches the storefront
# (e.g. http://127.0.0.1:3000 with PM2, http://frontend:3000 in Docker). Leave empty to refresh within 60 s.
REVALIDATE_SECRET=
STOREFRONT_INTERNAL_URL=
# Category slugs shown at the end of Shop all on the default sort (comma separated, empty = none)
SHOP_LIST_LAST_CATEGORIES=vehicle-generator-care
ADMIN_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# Comma-separated list. Defaults to STOREFRONT_URL,ADMIN_URL
CORS_ORIGINS=
# Leave empty for host-only cookies (recommended when /api is proxied on each host)
COOKIE_DOMAIN=
# Number of reverse proxies in front of the API (1 behind Nginx)
TRUST_PROXY=0

# ---- Database / cache -------------------------------------------------
# Use a replica set in production so multi-document transactions are available:
# mongodb://user:pass@127.0.0.1:27017/daredevil_gears?replicaSet=rs0&authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/daredevil_gears
# auto | on | off  — auto detects replica-set support
MONGODB_TRANSACTIONS=auto
# Optional. Enables BullMQ background queues (emails, retries). Without it jobs run in-process.
REDIS_URL=
# true = API process also runs the BullMQ workers (single-server setups). Otherwise run `npm run worker`.
RUN_WORKER_INLINE=false

# ---- Auth secrets (REQUIRED, ≥ 32 chars each, all different) ----------
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ADMIN_JWT_SECRET=change-me-admin-secret-at-least-32-characters-long
OTP_PEPPER=change-me-otp-pepper-32chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=8
# Admins must enrol an authenticator app (TOTP) before using the dashboard
ADMIN_MFA_REQUIRED=true

# ---- Email OTP ----------------------------------------------------------
OTP_TTL_MIN=10
OTP_RESEND_COOLDOWN_SEC=60
OTP_MAX_ATTEMPTS=5

# ---- SMTP (required in production) -------------------------------------
# Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  (or 587 + false)
#         SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password, NOT your Gmail password>
#         MAIL_FROM_ADDRESS must be that same Gmail address (or a verified "Send mail as" alias)
# Test the settings without the app:  npm run email:test -- you@example.com
# Restart the backend after changing this file.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Local development only: set to false if antivirus/proxy SSL scanning causes
# "self-signed certificate in certificate chain". The API refuses to start with this in production.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=DareDevil Gears
MAIL_FROM_ADDRESS=sales@daredevilgears.com
ADMIN_NOTIFY_EMAIL=
# Development only: when SMTP_HOST is empty, emails are written to backend/.outbox/
MAIL_DEV_OUTBOX=true

# ---- Razorpay (test keys first: rzp_test_...) ---------------------------
# Both are required (Dashboard → Account & Settings → API Keys). Use a matching pair:
# rzp_test_… with its test secret while testing, rzp_live_… with its live secret in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Minutes a pending order holds stock before it expires
PAYMENT_EXPIRY_MIN=30

# ---- Cloudinary ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=daredevil-gears

# ---- Shipping provider --------------------------------------------------
# Shiprocket: create an API user in Shiprocket → Settings → API → Configure → Create an API user
# (a separate email from your Shiprocket login). With these set:
#   - delivery charges at checkout come live from Shiprocket for the customer's PIN code
#   - paid orders are created in Shiprocket automatically
# Pickup PIN code / location name and the other options are in Admin → Settings → Shiprocket.
# Leave empty to use the manual shipping zones and enter tracking numbers by hand.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# ---- Logging / monitoring ----------------------------------------------
LOG_LEVEL=info
# Optional: install @sentry/node in backend/ to enable
SENTRY_DSN=

# ---- Initial Super Admin (used once by `npm run seed:admin`) -------------
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
