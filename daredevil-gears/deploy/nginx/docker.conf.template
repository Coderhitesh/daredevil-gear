# Docker Compose Nginx (HTTP). ${STORE_HOST} / ${ADMIN_HOST} are filled by the nginx image's envsubst.
# Put TLS in front (a cloud load balancer or the production config in daredevilgears.conf).
limit_req_zone $binary_remote_addr zone=ddg_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=ddg_auth:10m rate=5r/m;
client_max_body_size 12m;

upstream ddg_api { server backend:4000; keepalive 16; }
upstream ddg_store { server frontend:3000; keepalive 16; }
upstream ddg_admin { server admin:3000; keepalive 8; }

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

server {
  listen 80;
  server_name ${STORE_HOST};

  location = /api/v1/webhooks/razorpay { proxy_pass http://ddg_api; include /etc/nginx/conf.d/ddg-proxy.inc; }
  location ~ ^/api/v1/auth/(login|register|verify-email|resend-otp|forgot-password|reset-password) { limit_req zone=ddg_auth burst=10 nodelay; proxy_pass http://ddg_api; include /etc/nginx/conf.d/ddg-proxy.inc; }
  # the storefront never needs admin endpoints
  # uptime probe (database connectivity)
  location = /api/ready { proxy_pass http://ddg_api/ready; include /etc/nginx/conf.d/ddg-proxy.inc; }
  location /api/v1/admin/ { return 404; }
  location /api/ { limit_req zone=ddg_api burst=40 nodelay; proxy_pass http://ddg_api; include /etc/nginx/conf.d/ddg-proxy.inc; }
  location /_next/static/ { proxy_pass http://ddg_store; add_header Cache-Control "public, max-age=31536000, immutable"; }
  location / { proxy_pass http://ddg_store; include /etc/nginx/conf.d/ddg-proxy.inc; }
}

server {
  listen 80;
  server_name ${ADMIN_HOST};

  location /api/v1/admin/auth/login { limit_req zone=ddg_auth burst=5 nodelay; proxy_pass http://ddg_api; include /etc/nginx/conf.d/ddg-proxy.inc; }
  location /api/v1/admin/ { limit_req zone=ddg_api burst=40 nodelay; proxy_pass http://ddg_api; include /etc/nginx/conf.d/ddg-proxy.inc; }
  location /api/ { return 404; }
  location / { proxy_pass http://ddg_admin; include /etc/nginx/conf.d/ddg-proxy.inc; }
}
