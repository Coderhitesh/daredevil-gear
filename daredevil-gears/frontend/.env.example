# Server-side URL the storefront uses to reach the backend (internal network). Also the dev /api proxy target (build time).
API_INTERNAL_URL=http://127.0.0.1:4000
# Public site URL for canonical links, sitemap and robots (read at runtime)
SITE_URL=https://www.daredevilgears.com
# Build-time fallback for SITE_URL
NEXT_PUBLIC_SITE_URL=https://www.daredevilgears.com
