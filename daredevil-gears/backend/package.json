    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:products": "node scripts/seed-products.js",
    "seed:products:dry": "node scripts/seed-products.js --dry-run",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:content": "node scripts/seed-content.js",
    "seed:all": "node scripts/seed-all.js",
    "reconcile:payments": "node scripts/reconcile-payments.js",
    "indexes": "node scripts/sync-indexes.js",
    "email:test": "node scripts/test-email.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bullmq": "^5.34.0",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.7",
    "multer": "^2.5.0",
    "nodemailer": "^6.9.16",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "razorpay": "^2.9.5",
    "sanitize-html": "2.17.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
